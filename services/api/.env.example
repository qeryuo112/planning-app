# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/planning_app?schema=public

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI 模型配置（OpenAI 兼容接口）
# AI_PROVIDER 仅用于日志标签：openai / deepseek / custom
AI_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek 示例
# AI_PROVIDER=deepseek
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# AI 日费用上限（美元），超过后自动降级为占位草案/复盘
AI_DAILY_COST_LIMIT_USD=1.0

# 外部日历 OAuth（个人版可选；未配置时接口返回未启用提示）
# Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://xutaostudy.xyz/api/v1/calendar/oauth/google/callback
# Azure Portal: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=https://xutaostudy.xyz/api/v1/calendar/oauth/outlook/callback

# OAuth token / state 加密密钥；未设置时回退到 JWT_SECRET（生产环境务必单独设置）
OAUTH_ENCRYPTION_KEY=

# 服务端口号
PORT=3001

# 日志级别
LOG_LEVEL=info
